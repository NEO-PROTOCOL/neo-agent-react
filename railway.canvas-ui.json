{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install && pnpm --dir apps/canvas-ui build"
  },
  "deploy": {
    "startCommand": "pnpm --dir apps/canvas-ui start",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
